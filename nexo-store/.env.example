# ===========================================
# NEXO STORE - Variáveis de ambiente
# Copie este arquivo para ".env" e ajuste os valores
# ===========================================

# Porta do servidor
PORT=3000

# Segredo usado para assinar os tokens de sessão (gere um valor aleatório forte em produção)
SESSION_SECRET=troque-este-valor-por-um-segredo-forte-e-aleatorio

# Ambiente: development | production
NODE_ENV=development

# Caminho do banco de dados SQLite
DB_PATH=./data/nexostore.db

# -------------------------------------------
# Pagamentos (ambiente de testes/sandbox)
# Troque pelas chaves reais do seu provedor (Mercado Pago, Stripe, PagSeguro, etc.)
# Enquanto não configurado, o sistema usa o PaymentGateway simulado (server/payment-gateway.js)
# -------------------------------------------
PAYMENT_PROVIDER=sandbox
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=

# -------------------------------------------
# Frete - ViaCEP é público e gratuito (não precisa de chave)
# Caso use uma transportadora/API paga (Correios, Melhor Envio), informe aqui
# -------------------------------------------
SHIPPING_PROVIDER=sandbox
MELHOR_ENVIO_TOKEN=
